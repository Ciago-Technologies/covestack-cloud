{
  "algorithm": "KAN1-HMAC-SHA256",
  "dateHeader": "X-Kan-Date",
  "accessKeyHeader": "X-Kan-Access-Key",
  "signatureHeader": "X-Kan-Signature",
  "nonceHeader": "X-Kan-Nonce",
  "alwaysSignedHeaders": [
    "host",
    "x-kan-access-key",
    "x-kan-date",
    "x-kan-nonce"
  ],
  "signBodyContentTypeHeader": true,
  "maxClockSkewSeconds": 300,
  "nonceReplayWindowSeconds": 600,
  "dateFormat": "yyyyMMdd'T'HHmmss'Z'"
}
